---
import { SITE } from '../lib/site';
const year = new Date().getFullYear();
const s = SITE.socials;
---
<footer class="site-footer">
  <div class="container">
    <p>
      <a href={s.instagram}>Instagram</a>
      <a href={s.youtube}>YouTube</a>
      <a href={s.soundcloud}>SoundCloud</a>
      <a href={s.mixcloud}>Mixcloud</a>
      <a href={s.facebook}>Facebook</a>
      <a href={s.linkedin}>LinkedIn</a>
    </p>
    <p class="muted">&copy; {year} {SITE.name} ({SITE.author}). Scratch the World. · <a href="/sitemap-index.xml">Sitemap</a></p>
  </div>
</footer>
