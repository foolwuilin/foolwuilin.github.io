---
import { SITE } from '../lib/site';
interface Props {
  title: string;
  description?: string;
  image?: string;       // absolute URL preferred
  type?: string;
  jsonld?: object | object[];
}
const { title, description = SITE.description, image, type = 'website', jsonld } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href.replace(/\/$/, '') || SITE.url;
const ogImage = image || new URL('/favicon.png', SITE.url).href;
const fullTitle = title === SITE.name ? title : `${title} — ${SITE.name}`;
const blocks = jsonld ? (Array.isArray(jsonld) ? jsonld : [jsonld]) : [];
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="icon" type="image/png" href="/favicon.png" />
<meta name="theme-color" content="#111111" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
{blocks.map((b) => (
  <script type="application/ld+json" set:html={JSON.stringify(b)} />
))}
