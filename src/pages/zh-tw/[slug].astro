---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../lib/site';
import { cld } from '../../lib/cloudinary';
import { tagSlug } from '../../lib/tags';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const items = (await getCollection('zh')).filter((e) => !e.data.draft);
  return items.map((e) => ({ params: { slug: e.slug }, props: { entry: e } }));
}

const SECTION_ZH = {
  'scratch-the-world': 'Scratch the World',
  tutorials: '刷碟教學',
  gear: '器材',
};

const { entry } = Astro.props;
const { Content } = await entry.render();
const d = entry.data;
const zhUrl = new URL(`/zh-tw/${entry.slug}`, SITE.url).href;
const enPath = `/${d.section}/${d.enSlug}/`;
const enUrl = new URL(`/${d.section}/${d.enSlug}`, SITE.url).href;
const img = cld(d.coverImage, { w: 1200 });

const alternates = [
  { hreflang: 'en', href: enUrl },
  { hreflang: 'zh-Hant-TW', href: zhUrl },
  { hreflang: 'x-default', href: enUrl },
];

const articleLd = {'@context':'https://schema.org','@type':'BlogPosting',
  headline:d.title, description:d.summary, image:img, datePublished:d.date.toISOString(),
  inLanguage:'zh-Hant-TW',
  author:{'@type':'Person',name:SITE.name,alternateName:SITE.altNames,url:SITE.url},
  publisher:{'@type':'Organization',name:SITE.name}, mainEntityOfPage:zhUrl};
const videoLd = d.youtube ? {'@context':'https://schema.org','@type':'VideoObject',
  name:d.title, description:d.summary, thumbnailUrl:img, uploadDate:d.date.toISOString(),
  contentUrl:`https://www.youtube.com/watch?v=${d.youtube}`, embedUrl:`https://www.youtube.com/embed/${d.youtube}`} : null;
const breadcrumbLd = {'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[
  {'@type':'ListItem',position:1,name:'首頁',item:SITE.url},
  {'@type':'ListItem',position:2,name:SECTION_ZH[d.section],item:new URL(`/${d.section}`,SITE.url).href},
  {'@type':'ListItem',position:3,name:d.title,item:zhUrl}]};
const jsonld = [articleLd, breadcrumbLd]; if (videoLd) jsonld.push(videoLd);
const dateStr = d.date.toLocaleDateString('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' });
---
<BaseLayout title={d.title} description={d.summary} image={img} type="article" lang="zh-Hant-TW" alternates={alternates} jsonld={jsonld}>
  <nav class="breadcrumbs container" aria-label="Breadcrumb">
    <a href="/">首頁</a><span> › </span><a href={`/${d.section}/`}>{SECTION_ZH[d.section]}</a><span> › </span><span aria-current="page">{d.title}</span>
  </nav>
  <main class="container section">
    <p class="meta">🌐 <a href={enPath}>English</a> ・ <strong>中文（本頁）</strong></p>
    <article class="prose">
      {d.location && <span class="tag">{d.location}</span>}
      <h1>{d.title}</h1>
      <p class="meta">{dateStr}</p>
      <p class="lead">{d.summary}</p>
      <img src={img} width="1200" height="675" alt={d.coverAlt} />
      {d.youtube && (<div class="video"><iframe loading="lazy" src={`https://www.youtube.com/embed/${d.youtube}`} title={d.title} allowfullscreen></iframe></div>)}
      <Content />
      {d.tags && d.tags.length > 0 && (
        <div class="post-tags">{d.tags.map((t) => <a href={`/tags/${tagSlug(t)}/`}>#{t}</a>)}</div>
      )}
      <p class="meta" style="margin-top:2rem">👉 <a href={enPath}>Read this story in English</a></p>
    </article>
  </main>
</BaseLayout>
