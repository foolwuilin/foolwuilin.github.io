---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { SITE } from '../../lib/site';
import { cld } from '../../lib/cloudinary';
import { getCollection } from 'astro:content';
export async function getStaticPaths(){
  const items = (await getCollection('scratch-the-world')).filter(e=>!e.data.draft);
  return items.map(e=>({params:{slug:e.slug}, props:{entry:e}}));
}
const { entry } = Astro.props;
const { Content } = await entry.render();
const d = entry.data;
const pageUrl = new URL(`/scratch-the-world/${entry.slug}`, SITE.url).href;
const img = cld(d.coverImage,{w:1200});
const articleLd = {'@context':'https://schema.org','@type':'BlogPosting',
  headline:d.title, description:d.summary, image:img, datePublished:d.date.toISOString(),
  author:{'@type':'Person',name:SITE.name,url:SITE.url},
  publisher:{'@type':'Organization',name:SITE.name},
  mainEntityOfPage:pageUrl,
  contentLocation:{'@type':'Place',name:d.location, ...(d.lat&&d.lng?{geo:{'@type':'GeoCoordinates',latitude:d.lat,longitude:d.lng}}:{})}};
const videoLd = d.youtube ? {'@context':'https://schema.org','@type':'VideoObject',
  name:d.title, description:d.summary, thumbnailUrl:img, uploadDate:d.date.toISOString(),
  contentUrl:`https://www.youtube.com/watch?v=${d.youtube}`, embedUrl:`https://www.youtube.com/embed/${d.youtube}`} : null;
const breadcrumbLd = {'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[
  {'@type':'ListItem',position:1,name:'Home',item:SITE.url},
  {'@type':'ListItem',position:2,name:'Scratch the World',item:new URL('/scratch-the-world',SITE.url).href},
  {'@type':'ListItem',position:3,name:d.title,item:pageUrl}]};
const jsonld = [articleLd, breadcrumbLd]; if(videoLd) jsonld.push(videoLd);
---
<BaseLayout title={d.title} description={d.summary} image={img} type="article" jsonld={jsonld}>
  <Breadcrumbs items={[{label:'Home',href:'/'},{label:'Scratch the World',href:'/scratch-the-world'},{label:d.location}]} />
  <main class="container section">
    <article class="prose">
      <span class="tag">{d.location}</span>
      <h1>{d.title}</h1>
      <p class="meta">{d.date.toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric'})}{d.gear?` · ${d.gear}`:''}</p>
      <p class="lead">{d.summary}</p>
      <img src={img} width="1200" height="675" alt={d.coverAlt} />
      {d.youtube && (<div class="video"><iframe loading="lazy" src={`https://www.youtube.com/embed/${d.youtube}`} title={d.title} allowfullscreen></iframe></div>)}
      <Content />
    </article>
  </main>
</BaseLayout>
