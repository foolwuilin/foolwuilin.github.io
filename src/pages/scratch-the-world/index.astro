---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TagBar from '../../components/TagBar.astro';
import PostCard from '../../components/PostCard.astro';
import { SITE } from '../../lib/site';
import { getCollection } from 'astro:content';
const items = (await getCollection('scratch-the-world')).filter(e=>!e.data.draft).sort((a,b)=>+b.data.date-+a.data.date);
const breadcrumbLd = {'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[
  {'@type':'ListItem',position:1,name:'Home',item:SITE.url},
  {'@type':'ListItem',position:2,name:'Scratch the World',item:new URL('/scratch-the-world',SITE.url).href}]};
---
<BaseLayout title="Scratch the World" description="A city-by-city scratch travel diary from DJ FOOL Wuilin — portablism scratching everywhere he travels." jsonld={breadcrumbLd}>
  <Breadcrumbs items={[{label:'Home',href:'/'},{label:'Scratch the World'}]} />
  <main class="container section">
    <h1>Scratch the World</h1>
    <p class="lead">Every city is a session. A diary of scratching on location — like a tourist taking photos, but with a turntable.</p>
    <TagBar />
    <div class="grid cols-3" style="margin-top:1.5rem">
      {items.map(e => (
        <PostCard url={`/scratch-the-world/${e.slug}`} coverImage={e.data.coverImage} coverAlt={e.data.coverAlt} category={e.data.location} title={e.data.title} summary={e.data.summary} tags={e.data.tags} />
      ))}
    </div>
  </main>
</BaseLayout>
