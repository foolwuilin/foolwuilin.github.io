---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { SITE } from '../../lib/site';
import { cld } from '../../lib/cloudinary';
import { tagSlug } from '../../lib/tags';
import { getCollection } from 'astro:content';
export async function getStaticPaths(){
  const items = (await getCollection('gear')).filter(e=>!e.data.draft);
  return items.map(e=>({params:{slug:e.slug}, props:{entry:e}}));
}
const { entry } = Astro.props;
const { Content } = await entry.render();
const d = entry.data;
const pageUrl = new URL(`/gear/${entry.slug}`, SITE.url).href;
const img = cld(d.coverImage,{w:1200});
const articleLd = {'@context':'https://schema.org','@type':'Article',
  headline:d.title, description:d.summary, image:img, datePublished:d.date.toISOString(),
  author:{'@type':'Person',name:SITE.name,url:SITE.url}, publisher:{'@type':'Organization',name:SITE.name},
  mainEntityOfPage:pageUrl};
const breadcrumbLd = {'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[
  {'@type':'ListItem',position:1,name:'Home',item:SITE.url},
  {'@type':'ListItem',position:2,name:'Gear',item:new URL('/gear',SITE.url).href},
  {'@type':'ListItem',position:3,name:d.title,item:pageUrl}]};
---
<BaseLayout title={d.title} description={d.summary} image={img} type="article" jsonld={[articleLd, breadcrumbLd]}>
  <Breadcrumbs items={[{label:'Home',href:'/'},{label:'Gear',href:'/gear'},{label:d.title}]} />
  <main class="container section">
    <article class="prose">
      <h1>{d.title}</h1>
      <p class="lead">{d.summary}</p>
      <img src={img} width="1200" height="675" alt={d.coverAlt} />
      <Content />
      {d.tags && d.tags.length > 0 && (
        <div class="post-tags">{d.tags.map((t)=> <a href={`/tags/${tagSlug(t)}/`}>#{t}</a>)}</div>
      )}
    </article>
  </main>
</BaseLayout>
